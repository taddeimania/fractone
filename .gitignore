# ---------------------------------------------------------------------------
*.vst3/
*.component/
*.aaxplugin/
*.clap
*.app/
*.dSYM/
*.o
*.obj
*.a
*.lib
*.exp
*.dylib
*.so
*.dll
*.exe
*.pdb
*.ilk
Fractone-*.zip
Fractone-*.tar.gz

# Output of the FractoneSnapshot dev tool (renders and test WAVs).
# docs/ is tracked, so the README screenshot stays.
/*.png
/*.wav
/Tools/*.png
/Tools/*.wav

# User presets saved while testing
*.fractone

