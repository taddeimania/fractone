# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# CMake build directories (out-of-source)
build/
build-*/
cmake-build-*/
out/

# In-source CMake leftovers, in case cmake is ever run from the repo root
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json
/Makefile
/build.ninja
/.ninja_*

# JUCE: the CI cache checkout, FetchContent downloads, Projucer output
.juce/
_deps/
JuceLibraryCode/
Builds/

